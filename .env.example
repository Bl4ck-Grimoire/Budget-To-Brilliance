# MySQL Data Warehouse connection
# Copia este archivo como ".env" y cambia YOUR_PASSWORD por tu contraseña real
# de MySQL. NUNCA subas el archivo ".env" real a GitHub (ya está en .gitignore).
DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/icfes_dw

# Carpeta donde están los .txt de DataIcfes (Examen_Saber_11_20212.txt, ...)
ICFES_RAW_DIR=data/raw

# Filas por bloque al leer/cargar los archivos grandes
ICFES_CHUNK_SIZE=100000
