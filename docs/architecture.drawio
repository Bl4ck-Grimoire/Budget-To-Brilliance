<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="arch1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="System Architecture -- ETL Project (ICFES / ODS 4)" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="640" height="40" as="geometry" />
        </mxCell>

        <mxCell id="src" value="DataIcfes&#10;(.txt por periodo,&#10;2021-2 a 2025-2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#2b5b9e;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="160" height="100" as="geometry" />
        </mxCell>

        <mxCell id="extract" value="EXTRACT&#10;(detección encoding /&#10;separador, por bloques)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#2b5b9e;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="260" y="180" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="transform" value="TRANSFORM&#10;(limpieza + armonización&#10;+ modelo dimensional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#2b5b9e;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="load" value="LOAD&#10;(MySQL Data Warehouse,&#10;star schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#b8752a;fontSize=12;fontStyle=1;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="740" y="180" width="180" height="100" as="geometry" />
        </mxCell>

        <mxCell id="validate" value="VALIDATE&#10;(conteos, nulos, PK/FK,&#10;rango de puntajes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#2b5b9e;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="740" y="340" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sql" value="SQL&#10;(consultas analíticas&#10;R1-R5, KPIs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e9f7ef;strokeColor=#2e8b57;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="1020" y="120" width="180" height="90" as="geometry" />
        </mxCell>

        <mxCell id="powerbi" value="Power BI&#10;(dashboard ODS 4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecec;strokeColor=#c0392b;fontSize=12;arcSize=12" vertex="1" parent="1">
          <mxGeometry x="1020" y="250" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Flechas principales -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="src" target="extract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="extract" target="transform">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="transform" target="load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="load" target="validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- El Data Warehouse (no los archivos) alimenta SQL y Power BI -->
        <mxCell id="e5" value="conexión en vivo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;fontStyle=2" edge="1" parent="1" source="load" target="sql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="conexión en vivo&#10;(Import / DirectQuery)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;fontSize=10;fontStyle=2" edge="1" parent="1" source="load" target="powerbi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Power BI NUNCA lee los .txt fuente ni recibe archivos -- se conecta directo al Data Warehouse de MySQL ya cargado." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#555555" vertex="1" parent="1">
          <mxGeometry x="380" y="440" width="640" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
